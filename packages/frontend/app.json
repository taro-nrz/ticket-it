{
  "expo": {
    "name": "AI Ticket It",
    "slug": "ai-ticket-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16112A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "AI Ticket It",
      "shortName": "Ticket It",
      "themeColor": "#16112A",
      "backgroundColor": "#F5F3EE"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AI Ticket It usa la cámara para escanear el código QR de las entradas en la puerta.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AI Ticket It usa tus fotos para agregar imágenes a los eventos que publicás.",
          "cameraPermission": "AI Ticket It usa la cámara para sacar fotos de tus eventos y escanear entradas."
        }
      ]
    ],
    "scheme": "ticketit",
    "description": "Plataforma de venta de entradas para eventos (TP DDS, UTN FRBA)"
  }
}
