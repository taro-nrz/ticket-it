PORT=3000
# 0.0.0.0 permite que un celular en la misma red WiFi acceda al backend
HOST=0.0.0.0
# Orígenes permitidos para CORS separados por coma, o * para todos
ALLOWED_ORIGINS=*
NODE_ENV=development
MAX_ENTRADAS_POR_COMPRA=10
# Autenticación (D-29). En producción JWT_SECRET es obligatorio: generar con `openssl rand -hex 32`
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRACION=8h
BCRYPT_RONDAS=10
# Intentos fallidos de login permitidos por IP en la ventana (en milisegundos)
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA_MS=900000
